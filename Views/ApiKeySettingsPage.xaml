<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DoubleDashScore.ViewModels"
             x:Class="DoubleDashScore.Views.ApiKeySettingsPage"
             x:DataType="vm:ApiKeySettingsViewModel"
             Title="Inställningar">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="Hemsida"
                   FontAttributes="Bold"
                   FontSize="16" />

            <Label Text="{Binding WebSyncSubtitle}"
                   FontSize="13"
                   Opacity="0.75" />

            <!-- Primär action, samma stil som "Lägg till ny kväll" i Kvällar-vyn.
                 Syns först när en token är sparad. -->
            <Button Text="{Binding PublishButtonText}"
                    Command="{Binding PublishWebsiteCommand}"
                    IsVisible="{Binding HasGitHubToken}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="Black"
                    FontFamily="Baloo2Bold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="52"
                    Margin="0,8,0,0" />

            <ActivityIndicator IsRunning="{Binding IsPublishing}"
                               IsVisible="{Binding IsPublishing}"
                               HorizontalOptions="Center" />

            <Label Text="Byt token"
                   FontSize="13"
                   TextColor="{StaticResource Primary}"
                   TextDecorations="Underline"
                   HorizontalOptions="Start"
                   IsVisible="{Binding ShowChangeTokenLink}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChangeGitHubTokenCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowGitHubTokenEntry}">
                <Label Text="GitHub Personal Access Token"
                       FontAttributes="Bold"
                       Margin="0,8,0,0" />
                <Entry Text="{Binding GitHubTokenText, Mode=TwoWay}"
                       IsPassword="True"
                       Placeholder="github_pat_..."
                       Keyboard="Default" />
                <Button Text="Spara token"
                        Command="{Binding SaveGitHubTokenCommand}"
                        HorizontalOptions="Start" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light=#DDDDDD, Dark=#444444}"
                     Margin="0,16" />

            <Label Text="Anthropic API-nyckel"
                   FontAttributes="Bold"
                   FontSize="16" />

            <Label Text="Används för OCR via Claude Vision. Lagras säkert i enhetens nyckelring."
                   FontSize="13"
                   Opacity="0.75" />

            <Label Text="Status:" FontAttributes="Bold" Margin="0,12,0,0" />
            <Label Text="{Binding CurrentStatus}" FontSize="14" />

            <Label Text="Ange nyckel:" FontAttributes="Bold" Margin="0,12,0,0" />
            <Entry Text="{Binding EntryText, Mode=TwoWay}"
                   IsPassword="True"
                   Placeholder="sk-ant-..."
                   Keyboard="Default" />

            <HorizontalStackLayout Spacing="12" Margin="0,12,0,0">
                <Button Text="Spara" Command="{Binding SaveCommand}" />
                <Button Text="Rensa" Command="{Binding ClearCommand}" />
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               Margin="0,12,0,0" />

            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light=#DDDDDD, Dark=#444444}"
                     Margin="0,16" />

            <Label Text="Auto-backup"
                   FontAttributes="Bold"
                   FontSize="16" />

            <Label Text="Appen tar automatiskt en .db-säkerhetskopia när du ändrar något. Den behåller de 10 senaste."
                   FontSize="13"
                   Opacity="0.75" />

            <Label Text="{Binding BackupLatestLine}" FontSize="14" Margin="0,8,0,0" />
            <Label Text="{Binding BackupCountLine}" FontSize="14" />

            <Button Text="Återställ från auto-backup"
                    Command="{Binding OpenRestoreCommand}"
                    IsEnabled="{Binding HasBackups}"
                    HorizontalOptions="Start"
                    Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
